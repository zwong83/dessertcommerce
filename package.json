{
  "name": "sweetcommerce",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev frontend --hostname 127.0.0.1",
    "build": "next build frontend",
    "start": "next start frontend --hostname 127.0.0.1",
    "worker": "tsx frontend/server/worker/main.ts",
    "check:types": "next typegen frontend && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run contract:check && npm run check:types && npm test",
    "contract:generate": "node scripts/generate-contract.mjs",
    "contract:check": "node scripts/generate-contract.mjs --check",
    "dev:isolated": "tsx scripts/dev-isolated.ts",
    "dev:persistent": "node --env-file=.env.persistent.local --import tsx scripts/dev-isolated.ts --persistent"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.16",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "16.15.0-beta.19",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
