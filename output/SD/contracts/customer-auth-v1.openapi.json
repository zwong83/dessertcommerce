{
  "openapi": "3.1.0",
  "info": {
    "title": "SweetCommerce account authentication extension",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/admin/auth/registration/challenges": {
      "post": {
        "operationId": "startMerchantRegistration",
        "summary": "Request a setup code for the enrolled merchant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "verifiedContact"
                ],
                "properties": {
                  "verifiedContact": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 254
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Merchant setup challenge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or origin",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input or verification code",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Try again later",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/admin/auth/registration": {
      "post": {
        "operationId": "registerMerchantCredentials",
        "summary": "Set up credentials for the enrolled merchant after contact verification",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "challengeId",
                  "code",
                  "registration"
                ],
                "properties": {
                  "challengeId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$"
                  },
                  "registration": {
                    "$ref": "#/components/schemas/Registration"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Merchant credentials saved and session established",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or origin",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Merchant credentials are already configured",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input or verification code",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Try again later",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/admin/auth/password": {
      "post": {
        "operationId": "signInMerchantWithPassword",
        "summary": "Sign in to the merchant portal with username and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,31}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Merchant session established",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or origin",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input or verification code",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Try again later",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/auth/customer/otp/challenges": {
      "post": {
        "operationId": "startCustomerAccessChallenge",
        "summary": "Request an OTP bound to log-in or sign-up",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "phone",
                  "intent"
                ],
                "properties": {
                  "phone": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 16,
                    "pattern": "^\\+[1-9][0-9]{7,14}$"
                  },
                  "intent": {
                    "type": "string",
                    "enum": [
                      "login",
                      "signup"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Challenge issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or origin",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input or code",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Try again later",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/auth/customer/otp/verify": {
      "post": {
        "operationId": "verifyCustomerAccessChallenge",
        "summary": "Verify phone and open a customer session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "intent",
                      "challengeId",
                      "code"
                    ],
                    "properties": {
                      "intent": {
                        "const": "login"
                      },
                      "challengeId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "code": {
                        "type": "string",
                        "minLength": 6,
                        "maxLength": 6,
                        "pattern": "^[0-9]{6}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "intent",
                      "challengeId",
                      "code",
                      "registration"
                    ],
                    "properties": {
                      "intent": {
                        "const": "signup"
                      },
                      "challengeId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "code": {
                        "type": "string",
                        "minLength": 6,
                        "maxLength": 6,
                        "pattern": "^[0-9]{6}$"
                      },
                      "registration": {
                        "$ref": "#/components/schemas/Registration"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customer session established",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or origin",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Registration conflicts with an existing account",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input or code",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/auth/customer/password": {
      "post": {
        "operationId": "signInCustomerWithPassword",
        "summary": "Log in with a customer username and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 32,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,31}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customer session established",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or origin",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input or code",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Try again later",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/auth/customer/registration": {
      "post": {
        "operationId": "registerCustomerWithPassword",
        "summary": "Create a new password account and sign in when customer phone verification is paused",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["registration", "phone"],
                "properties": {
                  "registration": { "$ref": "#/components/schemas/Registration" },
                  "phone": {
                    "type": "string",
                    "pattern": "^\\+[1-9][0-9]{7,14}$",
                    "description": "Unverified contact number. Does not enable phone login."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Customer created and session established",
            "headers": { "Set-Cookie": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } }
          },
          "400": {
            "description": "Invalid request or origin",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "403": {
            "description": "Phone verification is required in this environment",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "409": {
            "description": "Username already registered",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "422": {
            "description": "Invalid registration or contact details",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "429": {
            "description": "Too many sign-up attempts",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "503": {
            "description": "Service unavailable",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/auth/customer/account": {
      "get": {
        "operationId": "getCustomerAccount",
        "summary": "Read the signed-in customer's account settings",
        "responses": {
          "200": {
            "description": "Signed-in customer account profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerAccount"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Customer access or valid request token required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateCustomerAccount",
        "summary": "Update the signed-in customer's profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "displayName"
                ],
                "properties": {
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "username": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,31}$"
                  },
                  "phone": {
                    "type": "string",
                    "pattern": "^\\+[1-9][0-9]{7,14}$",
                    "description": "Contact phone. Updating this does not change a verified login number."
                  },
                  "email": {
                    "type": ["string", "null"],
                    "format": "email",
                    "maxLength": 254,
                    "description": "Contact email. Omit to keep it, or send null to remove it."
                  },
                  "avatar": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "mediaType",
                          "data"
                        ],
                        "properties": {
                          "mediaType": {
                            "type": "string",
                            "enum": [
                              "image/jpeg",
                              "image/png",
                              "image/webp"
                            ]
                          },
                          "data": {
                            "type": "string",
                            "contentEncoding": "base64"
                          }
                        }
                      }
                    ],
                    "description": "Omit to keep the current picture, or send null to remove it."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed-in customer account profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerAccount"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Customer access or valid request token required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Username unavailable or change interval still active",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid profile details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/auth/customer/account/photo": {
      "get": {
        "operationId": "getCustomerAccountPhoto",
        "summary": "Read the signed-in customer's profile picture",
        "responses": {
          "200": {
            "description": "Private profile picture",
            "content": {
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Customer access or valid request token required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No profile picture",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/auth/customer/account/password": {
      "post": {
        "operationId": "changeCustomerPassword",
        "summary": "Verify the current password before replacing it",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "currentPassword",
                  "newPassword"
                ],
                "properties": {
                  "currentPassword": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "newPassword": {
                    "$ref": "#/components/schemas/Registration/properties/password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Customer access or valid request token required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Password changed concurrently",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid current or new password",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/auth/customer/profile": {
      "get": {
        "operationId": "getCustomerProfile",
        "summary": "Read the signed-in customer display name",
        "responses": {
          "200": {
            "description": "Customer profile (the display name is null for a phone-only account)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerProfile"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Customer access required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CustomerAccount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName",
          "username",
          "avatarVersion",
          "usernameChangeAvailableAt",
          "phone",
          "email"
        ],
        "properties": {
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          },
          "avatarVersion": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "usernameChangeAvailableAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "phone": {
            "type": ["string", "null"]
          },
          "email": {
            "type": ["string", "null"],
            "format": "email"
          }
        }
      },
      "Registration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "username",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Public-facing display name shown to the signed-in customer."
          },
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "format": "email"
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,31}$",
            "description": "Case-insensitive account identity for password log-in; not displayed in the storefront header."
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "(?=[\\s\\S]*[a-z])(?=[\\s\\S]*[A-Z])(?=[\\s\\S]*[0-9])(?=[\\s\\S]*[\\x21-\\x2f\\x3a-\\x40\\x5b-\\x60\\x7b-\\x7e])",
            "description": "At least one lowercase ASCII letter, uppercase ASCII letter, ASCII digit and ASCII punctuation symbol."
          }
        }
      },
      "Challenge": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "resendAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "challengeId",
          "expiresAt",
          "resendAt"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "ADMIN"
            ]
          },
          "csrfToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "accountId",
          "role",
          "csrfToken",
          "expiresAt"
        ]
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "VALIDATION",
              "OTP_INVALID",
              "OTP_EXPIRED",
              "RATE_LIMITED",
              "CAPACITY_UNAVAILABLE",
              "VERSION_CONFLICT",
              "INVALID_TRANSITION",
              "IDEMPOTENCY_CONFLICT",
              "DEADLINE_PASSED",
              "UNSUPPORTED_MEDIA",
              "PAYLOAD_TOO_LARGE",
              "DEPENDENCY_UNAVAILABLE",
              "INTERNAL",
              "REVIEW_STALE",
              "TERMS_CHANGED",
              "FEE_CHANGED",
              "QUOTE_EXPIRED",
              "PROOF_NOT_REVIEWABLE",
              "REFUND_LIMIT_EXCEEDED",
              "ORIGIN_DENIED",
              "DEPOSIT_DISPOSITION_REQUIRED",
              "CREDENTIALS_INVALID",
              "REGISTRATION_CONFLICT"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250,
            "example": "Review the current total and handoff before submitting."
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              },
              "required": [
                "field",
                "code"
              ]
            },
            "maxItems": 30
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "requestId",
          "retryable"
        ]
      },
      "CustomerProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName"
        ],
        "properties": {
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          }
        }
      }
    }
  }
}
